{
  "name": "distribution-finance",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @df/web",
    "dev:api": "npm run start:dev -w @df/api",
    "build": "npm run build -w @df/api && npm run build -w @df/web",
    "test": "npm test -w @df/api",
    "db:migrate": "npm run db:migrate -w @df/api",
    "db:studio": "npm run db:studio -w @df/api"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
