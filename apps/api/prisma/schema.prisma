// Prisma 7: the connection URL lives in prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SyncStatus {
  running
  succeeded
  failed
}

/// One pull of a Salesdoc method (getOrder, getPayment, getBalance, ...).
model SyncRun {
  id         String     @id @default(uuid())
  method     String
  status     SyncStatus @default(running)
  records    Int        @default(0)
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?

  @@index([method, startedAt])
}

// ─── Mirrored from Salesdoc (read-only in the app) ───────────────────────
// Every mirrored row: sdId = Salesdoc SD_id, raw = the row as received,
// seenAt = when a sync last saw it (rows not seen by a completed full pass
// are deleted). References between mirrored tables are plain sdId strings
// without foreign keys: Salesdoc may reference rows it no longer lists.

model PaymentType {
  sdId   String   @id
  csId   String?
  code1c String?
  name   String
  short  String?
  active Boolean
  raw    Json
  seenAt DateTime
}

model Cashbox {
  sdId   String   @id
  csId   String?
  code1c String?
  name   String
  active Boolean
  raw    Json
  seenAt DateTime
}

model Warehouse {
  sdId   String   @id
  csId   String?
  code1c String?
  name   String
  active Boolean
  raw    Json
  seenAt DateTime
}

model Supplier {
  sdId   String   @id
  csId   String?
  code1c String?
  name   String
  active Boolean
  raw    Json
  seenAt DateTime
}

model Agent {
  sdId   String   @id
  csId   String?
  code1c String?
  name   String
  active Boolean
  raw    Json
  seenAt DateTime
}

model Expeditor {
  sdId   String   @id
  csId   String?
  code1c String?
  name   String
  active Boolean
  raw    Json
  seenAt DateTime
}

/// Salesdoc product category (getProductCategory).
model ProductCategory {
  sdId   String   @id
  csId   String?
  code1c String?
  name   String
  active Boolean
  raw    Json
  seenAt DateTime
}

model Product {
  sdId         String   @id
  csId         String?
  code1c       String?
  name         String
  active       Boolean
  packQuantity Int?
  categorySdId String?
  raw          Json
  seenAt       DateTime
}

/// Current stock; sdId = "<warehouseSdId>:<productSdId>".
model StockLevel {
  sdId          String   @id
  warehouseSdId String
  productSdId   String
  productName   String
  quantity      Decimal  @db.Decimal(18, 3)
  seenAt        DateTime

  @@index([warehouseSdId])
}

model Outlet {
  sdId          String    @id
  csId          String?
  code1c        String?
  name          String
  firmName      String?
  inn           String?
  address       String?
  active        Boolean
  expeditorSdId String?
  updatedAtSd   DateTime?
  raw           Json
  seenAt        DateTime
}

/// Goods receipt from a supplier; sdId comes from purchase_id without its filial prefix.
model Purchase {
  sdId          String         @id
  csId          String?
  date          DateTime
  updatedAtSd   DateTime?
  warehouseSdId String?
  supplierSdId  String?
  total         Decimal        @db.Decimal(18, 2)
  raw           Json
  seenAt        DateTime
  lines         PurchaseLine[]

  @@index([date])
}

model PurchaseLine {
  id           Int      @id @default(autoincrement())
  purchaseSdId String
  purchase     Purchase @relation(fields: [purchaseSdId], references: [sdId], onDelete: Cascade)
  productSdId  String?
  productName  String
  quantity     Decimal  @db.Decimal(18, 3)
  price        Decimal  @db.Decimal(18, 2)
  amount       Decimal  @db.Decimal(18, 2)

  @@index([purchaseSdId])
}

model Order {
  sdId               String      @id
  csId               String?
  code1c             String?
  status             Int
  dateDocument       DateTime
  dateCreate         DateTime?
  dateDelivered      DateTime?
  totalSumma         Decimal     @db.Decimal(18, 2)
  discountSumma      Decimal     @db.Decimal(18, 2)
  totalAfterDiscount Decimal     @db.Decimal(18, 2)
  totalReturnsSumma  Decimal     @db.Decimal(18, 2)
  debtDateExp        DateTime?   @db.Date
  outletSdId         String?
  agentSdId          String?
  expeditorSdId      String?
  warehouseSdId      String?
  paymentTypeSdId    String?
  raw                Json
  seenAt             DateTime
  lines              OrderLine[]

  @@index([outletSdId, status, dateDocument])
  @@index([dateDocument])
}

model OrderLine {
  id          Int     @id @default(autoincrement())
  orderSdId   String
  order       Order   @relation(fields: [orderSdId], references: [sdId], onDelete: Cascade)
  productSdId String?
  productName String?
  quantity    Decimal @db.Decimal(18, 3)
  price       Decimal @db.Decimal(18, 2)
  discount    Decimal @db.Decimal(18, 2)
  summa       Decimal @db.Decimal(18, 2)
  returned    Decimal @db.Decimal(18, 3)

  @@index([orderSdId])
}

/// A return from an outlet (getOrderDefect). amount is positive.
/// Not named "Return": `return` is a JavaScript keyword and would become a client property.
model OutletReturn {
  sdId          String       @id
  csId          String?
  status        Int
  dateDocument  DateTime
  amount        Decimal      @db.Decimal(18, 2)
  outletSdId    String?
  agentSdId     String?
  expeditorSdId String?
  warehouseSdId String?
  reason        String?
  raw           Json
  seenAt        DateTime
  lines         ReturnLine[]

  @@index([outletSdId, status, dateDocument])
}

model ReturnLine {
  id           Int          @id @default(autoincrement())
  returnSdId   String
  outletReturn OutletReturn @relation(fields: [returnSdId], references: [sdId], onDelete: Cascade)
  productSdId  String?
  quantity     Decimal      @db.Decimal(18, 3)
  price        Decimal      @db.Decimal(18, 2)
  summa        Decimal      @db.Decimal(18, 2)

  @@index([returnSdId])
}

model Payment {
  sdId            String              @id
  csId            String?
  code1c          String?
  paymentDate     DateTime
  amount          Decimal             @db.Decimal(18, 2)
  transactionType Int
  paymentTypeSdId String?
  outletSdId      String?
  agentSdId       String?
  cashboxSdId     String?
  comment         String?
  raw             Json
  seenAt          DateTime
  allocations     PaymentAllocation[]

  @@index([outletSdId, transactionType, paymentDate])
}

model PaymentAllocation {
  id          Int     @id @default(autoincrement())
  paymentSdId String
  payment     Payment @relation(fields: [paymentSdId], references: [sdId], onDelete: Cascade)
  orderSdId   String
  amount      Decimal @db.Decimal(18, 2)

  @@index([paymentSdId])
  @@index([orderSdId])
}

/// Salesdoc's current balance per outlet (getBalance): the anchor for outlet
/// settlements (spec §4.1). debt = -balance, so positive = the outlet owes us.
model OutletBalance {
  sdId   String   @id
  name   String?
  debt   Decimal  @db.Decimal(18, 2)
  raw    Json
  seenAt DateTime
}

/// Sync progress per resource (see SyncService).
model SyncCursor {
  resource      String    @id
  lastSuccessAt DateTime?
  /// Start of the last completed full pass: a prune deletes only rows that
  /// neither that pass nor the current one saw.
  lastFullStartedAt DateTime?
  fullStartedAt DateTime?
  nextPage      Int?
}

/// A person who can log in. Created with `npm run user:add -w @df/api`.
model User {
  id           String    @id @default(uuid())
  login        String    @unique
  name         String
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

/// A login session; id = SHA-256 of the token the browser holds.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// A month is open unless a row says closed. Closing is done by hand.
model Month {
  month       String    @id // YYYY-MM
  closed      Boolean   @default(false)
  changedById String?
  changedAt   DateTime?
}

/// Append-only history of edits, deletes, restores and month closing.
model AuditLog {
  id       String   @id @default(uuid())
  at       DateTime @default(now())
  userId   String
  userName String
  action   String
  target   String
  reason   String?
  before   Json?
  after    Json?

  @@index([target, at])
  @@index([action, at])
}

/// A receipt deleted in our app (Salesdoc has no delete). No FK on purpose:
/// the sync deletes and re-inserts Purchase rows, which must not erase this.
model PurchaseHidden {
  purchaseSdId String   @id
  hiddenById   String
  hiddenByName String
  hiddenAt     DateTime @default(now())
  reason       String
}

/// Our bank accounts (placeholder: «Основной счёт» until the owner lists them).
model BankAccount {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Статьи движения денег. kind: "expense" | "income".
model CashCategory {
  id        String   @id @default(uuid())
  name      String
  kind      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Which page a Salesdoc payment type lands on. Not a column on PaymentType: the sync recreates those rows.
model PaymentTypeAccount {
  paymentTypeSdId String @id
  account         String /// "cash" | "bank"
}

/// Money in or out, entered in our app (spec §3–4). Never deleted; cancelled instead.
model CashOperation {
  id               String    @id @default(uuid())
  seq              Int       @unique @default(autoincrement())
  direction        String    /// "in" | "out"
  account          String    /// "cash" | "bank"
  cashboxSdId      String?
  bankAccountId    String?
  date             DateTime  @db.Date
  amount           Decimal   @db.Decimal(18, 2)
  operation        String    /// a code from src/cash/operations.ts
  supplierSdId     String?
  outletSdId       String?
  categoryId       String?
  counterpartyName String?
  comment          String?
  createdById      String
  createdByName    String
  createdAt        DateTime  @default(now())
  cancelledAt      DateTime?
  cancelledById    String?
  cancelledByName  String?
  cancelReason     String?

  @@index([account, direction, date])
  @@index([supplierSdId, date])
}

/// Кадры: a department. nameKey = lower(trim(name)): names are unique whatever the case.
model Department {
  id             String     @id @default(uuid())
  name           String
  nameKey        String     @unique
  sortOrder      Int        @default(0)
  headEmployeeId String?
  head           Employee?  @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  positions      Position[]
  employees      Employee[] @relation("EmployeeDepartment")
  createdAt      DateTime   @default(now())
}

/// Кадры: a position. groupKey = departmentId or "-", so a name is unique within one department.
model Position {
  id           String      @id @default(uuid())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  groupKey     String
  name         String
  nameKey      String
  description  String?
  sortOrder    Int         @default(0)
  /// "HH:MM" — arrival threshold (Кадры part 2).
  startTime    String?
  /// ISO weekdays 1–7; empty = not set (part 2 falls back to the global rule).
  workdays     Int[]       @default([])
  employees    Employee[]
  createdAt    DateTime    @default(now())

  @@unique([groupKey, nameKey])
}

model TerminationReason {
  id        String   @id @default(uuid())
  label     String
  labelKey  String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Кадры: one person on the staff (spec §2).
model Employee {
  id                 String                    @id @default(uuid())
  lastName           String
  firstName          String
  middleName         String?
  /// «Фамилия Имя Отчество», rebuilt on every save.
  name               String
  phone              String?
  email              String?
  birthDate          DateTime?                 @db.Date
  birthPlace         String?
  nationality        String?
  citizenship        String?
  /// "male" | "female"
  gender             String?
  passportSeries     String?
  passportNumber     String?
  passportIssuedBy   String?
  passportIssuedDate DateTime?                 @db.Date
  passportValidUntil DateTime?                 @db.Date
  pinfl              String?                   @unique
  inn                String?
  address            String?
  /// higher | incomplete_higher | specialized_secondary | secondary | incomplete_secondary
  educationLevel     String?
  departmentId       String?
  department         Department?               @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  positionId         String?
  position           Position?                 @relation(fields: [positionId], references: [id], onDelete: SetNull)
  /// TD | GPH | IP | SZ
  employmentType     String?
  remote             Boolean                   @default(false)
  /// { "1": { "start": "09:00", "end": "18:00" }, … }; NULL = the position's schedule.
  workSchedule       Json?
  rate               Decimal                   @default(1) @db.Decimal(4, 2)
  /// so'm
  salary             Int?
  hiredAt            DateTime?                 @db.Date
  orderNumber        String?
  orderDate          DateTime?                 @db.Date
  experienceMonths   Int?
  /// intern | active | terminated
  status             String                    @default("active")
  terminatedAt       DateTime?
  terminationReason  String?
  createdAt          DateTime                  @default(now())
  createdById        String
  relatives          EmployeeRelative[]
  diplomas           EmployeeDiploma[]
  salesdocAccounts   EmployeeSalesdocAccount[]
  headOf             Department[]              @relation("DepartmentHead")

  @@index([status])
  @@index([departmentId])
  @@index([positionId])
}

model EmployeeRelative {
  id                String    @id @default(uuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// spouse | mother | father | child | sibling | other
  relation          String
  fullName          String?
  birthDate         DateTime? @db.Date
  workplacePosition String?
  residenceAddress  String?
  phone             String?
  createdAt         DateTime  @default(now())

  @@index([employeeId])
}

model EmployeeDiploma {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  degree        String?
  institution   String?
  specialty     String?
  enrolledYear  Int?
  graduatedYear Int?
  seriesNumber  String?
  issuedDate    DateTime? @db.Date
  status        String?
  createdAt     DateTime  @default(now())

  @@index([employeeId])
}

/// A Salesdoc account (route / expeditor / supervisor) a person works under. No FK to the synced tables: the sync recreates their rows.
model EmployeeSalesdocAccount {
  /// agent | expeditor | supervisor
  kind       String
  sdId       String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  linkedAt   DateTime @default(now())
  linkedById String

  @@id([kind, sdId])
  @@index([employeeId])
}

model Supervisor {
  sdId   String   @id
  csId   String?
  code1c String?
  name   String
  active Boolean
  raw    Json
  seenAt DateTime
}
